# Copy to .env and fill in the blanks. .env is gitignored — never commit real values.
# Generate secrets with: openssl rand -hex 32

POSTGRES_USER=chatbot
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot

RABBITMQ_USER=chatbot
RABBITMQ_PASSWORD=

# Host ports — change only if they collide with something else on your machine.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5434
RABBITMQ_MGMT_HOST_PORT=15672

# Only needed if running the app/tests directly on the host (outside docker compose):
# DATABASE_URL=postgresql+psycopg://chatbot:<password>@127.0.0.1:5434/chatbot
# REDIS_URL=redis://127.0.0.1:6379/0
# RABBITMQ_URL=amqp://chatbot:<password>@127.0.0.1:5672//

# Gemini API key — optional. Without it, only `--fake` runs work.
# GEMINI_API_KEY=

# LLM role model pins (Plan §11.4) — override only if the default in app/settings.py is
# unavailable (e.g. a provider-side outage on one pinned model; see DEMO.md). Leave commented
# out to use the defaults baked into docker-compose.yml / app/settings.py.
# PLANNER_MODEL=gemini-3.1-flash-lite
# GRADER_MODEL=gemini-3.1-flash-lite
# ANSWER_MODEL=gemini-3.6-flash
# EMBEDDING_MODEL=gemini-embedding-001

# JWT verification — shared secret with whatever service issues user tokens.
JWT_SECRET=
# JWT_ISSUER / JWT_AUDIENCE have dev defaults in docker-compose.yml.

# Token for the internal ingestion endpoint (service-to-service, not a user token).
INGESTION_SERVICE_TOKEN=

# Subscription lookup tool — optional. Without it, only `--fake` runs and requests
# that don't need the tool will work.
# SUBSCRIPTION_SERVICE_BASE_URL=
# SUBSCRIPTION_SERVICE_TOKEN=
