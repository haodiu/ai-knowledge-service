# Copy to .env and fill in. .env is gitignored — never commit real values.
# Use URL-safe characters (letters/digits) in passwords: they are embedded in connection URLs.

POSTGRES_USER=chatbot
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot

RABBITMQ_USER=chatbot
RABBITMQ_PASSWORD=

# Host ports (all bound to 127.0.0.1 except the API). Change if they collide with other projects.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5434
RABBITMQ_MGMT_HOST_PORT=15672

# Only used when running the app/tests on the host (outside compose):
# DATABASE_URL=postgresql+psycopg://chatbot:<password>@127.0.0.1:5434/chatbot
# REDIS_URL=redis://127.0.0.1:6379/0
# RABBITMQ_URL=amqp://chatbot:<password>@127.0.0.1:5672//

# Week 3: Gemini (chat via its OpenAI-compatible endpoint, embeddings via google-genai).
# Optional: without it only `--fake` runs work. Model names are pinned defaults in app/settings.py.
# GEMINI_API_KEY=

# Dev override: gemini-3.6-flash returned frequent 503s in Week 3; the code default stays 3.6-flash.
# ANSWER_MODEL=gemini-3.1-flash-lite

# Week 6: JWT verification (Plan §7). HS256 shared secret with the Spring Boot host -- generate
# with e.g. `openssl rand -hex 32`. JWT_ISSUER/JWT_AUDIENCE have dev defaults in docker-compose.yml
# but must match whatever mints the tokens in a real deployment.
JWT_SECRET=
# JWT_ISSUER=payment-subscription-platform
# JWT_AUDIENCE=rag-chatbot

# Week 6: internal ingestion endpoint (Plan §6). Separate shared secret from JWT_SECRET above --
# host-to-host, not a user token. Generate with `openssl rand -hex 32`.
INGESTION_SERVICE_TOKEN=
